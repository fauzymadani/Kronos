<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Swatch for the strip, its two on-colors, and a pale container pair: Material fills the
         slider's inactive track and checked toggles with the container color, so a strong
         container reads as a solid block. Purple is the base theme, so it has no overlay. -->
