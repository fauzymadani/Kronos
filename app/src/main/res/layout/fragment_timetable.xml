<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:title="@string/timetable_title" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/dayTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="scrollable"
        app:tabGravity="fill" />

    <TextView
        android:id="@+id/holidayBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceVariant"
        android:padding="12dp"
        android:textColor="?attr/colorOnSurface"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/dayTimelineContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <android.widget.ScrollView
            android:id="@+id/dayTimelineScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true">

            <com.example.kronos.ui.timetable.DayTimelineView
                android:id="@+id/dayTimeline"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </android.widget.ScrollView>

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/addClass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:text="@string/add_class"
            app:icon="@android:drawable/ic_input_add" />
    </FrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/classList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="12dp"
        android:visibility="gone"
        tools:listitem="@layout/item_class_session" />

    <com.example.kronos.ui.timetable.WeekGridView
        android:id="@+id/weekGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/monthGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.45"
        android:padding="4dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/monthClasses"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.55"
        android:clipToPadding="false"
        android:padding="12dp"
        android:visibility="gone"
        tools:listitem="@layout/item_class_session" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/monthExams"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.35"
        android:clipToPadding="false"
        android:padding="12dp"
        android:visibility="gone"
        tools:listitem="@layout/item_exam" />

</LinearLayout>
