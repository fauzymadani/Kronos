package com.example.kronos.ui.timetable
import android.content.Context
import android.graphics.Canvas
import android.graphics.Paint
import android.graphics.Rect
import android.graphics.RectF
import android.util.AttributeSet
import android.view.MotionEvent
import android.view.View
import android.view.ViewConfiguration
import android.widget.ScrollView
import androidx.core.graphics.ColorUtils
import com.example.kronos.R
import com.example.kronos.data.local.ClassSessionWithSubject
import com.example.kronos.data.local.ExamWithSubject
import com.example.kronos.data.SettingsStore
import com.example.kronos.lib.calculateDayTimelineLayout
import com.example.kronos.lib.contrastingTextColor
import com.example.kronos.lib.initialScrollMinutes
import com.example.kronos.lib.parseUserColor
import com.example.kronos.lib.formatDisplayTime
import java.time.LocalDate
import java.time.LocalTime
import kotlin.math.abs
import kotlin.math.ceil
import kotlin.math.max
import kotlin.math.min
import kotlin.math.roundToInt
private const val EXAM_HOUR_MINUTES = 60
class DayTimelineView @JvmOverloads constructor(
    context: Context,
    attrs: AttributeSet? = null
) : View(context, attrs) {
    var onClassClick: ((ClassSessionWithSubject) -> Unit)? = null
    private var day = LocalDate.now()
    private var layout = calculateDayTimelineLayout(emptyList())
    private var pendingScrollMinute = -1
    private var scrolledDay: LocalDate? = null
    private val rects = ArrayList<RectF>(24)
    private val blocks = ArrayList<ClassSessionWithSubject>(24)
    private var dayExams: List<ExamWithSubject> = emptyList()
    private val examRects = ArrayList<RectF>(8)
    private val examTitles = ArrayList<String>(8)
    private val examDetails = ArrayList<String>(8)
    private val examColors = ArrayList<Int>(8)
    private val blockText = ArrayList<String>(24)
    private val roomText = ArrayList<String>(24)
    private val blockColors = ArrayList<Int>(24)
    private val textColors = ArrayList<Int>(24)
    private val labelText = ArrayList<String>(24)
    private var currentLineMinute = -1
    private var timeFormat = SettingsStore(context).timeFormat
    private val density = resources.displayMetrics.density
    private val touchSlop = ViewConfiguration.get(context).scaledTouchSlop
    private val clipBounds = Rect()
    private var downX = 0f
    private var downY = 0f
    private val timeWidth = dp(58f)
    private val horizontalPadding = dp(8f)
    private val hourHeight = resources.getDimension(R.dimen.hour_height)
    private val minuteHeight = hourHeight / 60f
    private val blockGap = dp(3f)
    private val cornerRadius = dp(6f)
    private val lineColor = context.getColor(R.color.grid_line)
    private val textColor = context.getColor(R.color.on_surface_variant)
    private val strongTextColor = context.getColor(R.color.on_surface)
    private val accentColor = context.getColor(R.color.primary)
    private val linePaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
        color = lineColor
        strokeWidth = dp(1f)
    }
    private val halfLinePaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
        color = lineColor
        strokeWidth = dp(1f)
        alpha = 0x66
    }
    private val textPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
        textSize = dp(12f)
        typeface = android.graphics.Typeface.DEFAULT
        color = textColor
    }
    private val labelPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
        textSize = dp(12f)
        typeface = android.graphics.Typeface.DEFAULT
        color = textColor
    }
    private val boldTextPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
        textSize = dp(12f)
        typeface = android.graphics.Typeface.DEFAULT_BOLD
        color = strongTextColor
    }
    private val blockPaint = Paint(Paint.ANTI_ALIAS_FLAG)
    private val examFillPaint = Paint(Paint.ANTI_ALIAS_FLAG)
    private val examStrokePaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
        style = Paint.Style.STROKE
        strokeWidth = dp(1f)
    }
    private val examTintAlpha = 0x1F
    private val currentPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
        color = accentColor
        strokeWidth = dp(2f)
    }
    private val currentDotPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
        color = accentColor
    }
    private val primaryColor = accentColor
    fun setDay(
        value: LocalDate,
        sessions: List<ClassSessionWithSubject>,
        exams: List<ExamWithSubject> = emptyList()
    ) {
        timeFormat = SettingsStore(context).timeFormat
        day = value
        dayExams = exams
        layout = calculateDayTimelineLayout(sessions)
        val now = LocalTime.now()
        val nowMinutes = now.hour * 60 + now.minute
        val isToday = day == LocalDate.now()
        currentLineMinute = if (isToday) nowMinutes else -1
        if (value != scrolledDay) {
            scrolledDay = value
            pendingScrollMinute = initialScrollMinutes(
                sessions.map { LocalTime.parse(it.startTime).toSecondOfDay() / 60 } +
                    exams.mapNotNull { it.startTime }
                        .map { LocalTime.parse(it).toSecondOfDay() / 60 },
                isToday,
                nowMinutes
            )
        }
        rebuildRenderData()
        requestLayout()
        invalidate()
        post { applyPendingScroll() }
    }
    private fun yForMinute(minute: Int): Int =
        (minute * minuteHeight).toInt().coerceAtLeast(0)
    private fun applyPendingScroll() {
        if (pendingScrollMinute < 0 || height == 0) return
        val target = yForMinute(pendingScrollMinute)
        pendingScrollMinute = -1
        (parent as? ScrollView)?.scrollTo(0, target)
    }
    override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
        val fullDayHeight = (layout.durationMinutes * minuteHeight).toInt()
        setMeasuredDimension(
            MeasureSpec.getSize(widthMeasureSpec),
            resolveSize(fullDayHeight, heightMeasureSpec)
        )
    }
    override fun onSizeChanged(width: Int, height: Int, oldWidth: Int, oldHeight: Int) {
        rebuildRenderData()
        applyPendingScroll()
    }
    private val minuteTicker = object : Runnable {
        override fun run() {
            refreshCurrentMinute()
            postDelayed(this, 60_000L - System.currentTimeMillis() % 60_000L)
        }
    }
    override fun onAttachedToWindow() {
        super.onAttachedToWindow()
        postDelayed(minuteTicker, 60_000L - System.currentTimeMillis() % 60_000L)
    }
    override fun onDetachedFromWindow() {
        removeCallbacks(minuteTicker)
        super.onDetachedFromWindow()
    }
    private fun refreshCurrentMinute() {
        val now = LocalTime.now()
        val nowMinutes = now.hour * 60 + now.minute
        val line = if (day == LocalDate.now()) nowMinutes else -1
        if (line == currentLineMinute) return
        currentLineMinute = line
        rebuildRenderData()
        invalidate()
    }
    private fun examCountdownLabel(startMinute: Int, endMinute: Int): String? {
        if (day != LocalDate.now()) return null
        val now = LocalTime.now()
        val nowMinutes = now.hour * 60 + now.minute
        if (nowMinutes >= endMinute) return null
        if (nowMinutes >= startMinute) return context.getString(R.string.status_in_progress)
        val minutes = startMinute - nowMinutes
        return when {
            minutes <= 1 -> context.getString(R.string.exam_starts_soon)
            minutes < 60 -> context.getString(R.string.exam_starts_minutes, minutes)
            minutes <= 90 -> context.getString(R.string.exam_starts_hour)
            else -> context.getString(R.string.exam_starts_hours, (minutes / 60f).roundToInt())
        }
    }
    override fun onDraw(canvas: Canvas) {
        super.onDraw(canvas)
        val gridLeft = timeWidth + horizontalPadding
        val gridRight = width - horizontalPadding
        val hours = layout.lastMinute / 60
        canvas.getClipBounds(clipBounds)
        val firstHour = (clipBounds.top / hourHeight).toInt().coerceIn(0, hours)
        val lastHour = ceil(clipBounds.bottom / hourHeight).toInt().coerceIn(0, hours)
        var hour = firstHour
        while (hour <= lastHour) {
            val y = hour * hourHeight
            canvas.drawLine(gridLeft, y, gridRight, y, linePaint)
            if (hour < labelText.size) {
                drawTimeLabel(canvas, labelText[hour], y)
            }
            if (hour < hours) {
                val halfY = y + hourHeight / 2f
                canvas.drawLine(gridLeft, halfY, gridRight, halfY, halfLinePaint)
            }
            hour++
        }
        var index = 0
        while (index < rects.size) {
            val rect = rects[index]
            if (rect.bottom >= clipBounds.top && rect.top <= clipBounds.bottom) {
                val block = layout.blocks[index]
                blockPaint.color = blockColors[index]
                boldTextPaint.color = textColors[index]
                textPaint.color = textColors[index]
                textPaint.textAlign = Paint.Align.LEFT
                canvas.drawRoundRect(rect, cornerRadius, cornerRadius, blockPaint)
                canvas.save()
                canvas.clipRect(rect)
                val textLeft = rect.left + dp(6f)
                val baseline = rect.top + dp(16f)
                canvas.drawText(blockText[index], textLeft, baseline, boldTextPaint)
                if (roomText[index].isNotEmpty() && block.endMinute - block.startMinute >= 30) {
                    canvas.drawText(roomText[index], textLeft, baseline + dp(16f), textPaint)
                }
                canvas.restore()
            }
            index++
        }
        var examIndex = 0
        while (examIndex < examRects.size) {
            val rect = examRects[examIndex]
            if (rect.bottom >= clipBounds.top && rect.top <= clipBounds.bottom) {
                val color = examColors[examIndex]
                examFillPaint.color = ColorUtils.setAlphaComponent(color, examTintAlpha)
                examStrokePaint.color = color
                canvas.drawRoundRect(rect, cornerRadius, cornerRadius, examFillPaint)
                canvas.drawRoundRect(rect, cornerRadius, cornerRadius, examStrokePaint)
                canvas.save()
                canvas.clipRect(rect)
                boldTextPaint.color = strongTextColor
                textPaint.color = textColor
                textPaint.textAlign = Paint.Align.LEFT
                val textLeft = rect.left + dp(6f)
                val baseline = rect.top + dp(16f)
                canvas.drawText(examTitles[examIndex], textLeft, baseline, boldTextPaint)
                if (rect.height() >= dp(40f) && examDetails[examIndex].isNotEmpty()) {
                    canvas.drawText(examDetails[examIndex], textLeft, baseline + dp(16f), textPaint)
                }
                canvas.restore()
            }
            examIndex++
        }
        if (currentLineMinute >= 0) {
            val y = currentLineMinute * minuteHeight
            canvas.drawLine(gridLeft, y, gridRight, y, currentPaint)
            canvas.drawCircle(gridLeft, y, dp(4f), currentDotPaint)
        }
    }
    override fun onTouchEvent(event: MotionEvent): Boolean {
        when (event.actionMasked) {
            MotionEvent.ACTION_DOWN -> {
                downX = event.x
                downY = event.y
            }
            MotionEvent.ACTION_UP -> {
                if (abs(event.x - downX) <= touchSlop && abs(event.y - downY) <= touchSlop) {
                    performClick()
                    var index = rects.size - 1
                    while (index >= 0) {
                        if (rects[index].contains(event.x, event.y)) {
                            onClassClick?.invoke(blocks[index])
                            break
                        }
                        index--
                    }
                }
            }
        }
        return true
    }
    override fun performClick(): Boolean {
        super.performClick()
        return true
    }
    private fun rebuildRenderData() {
        rects.clear()
        blocks.clear()
        blockText.clear()
        roomText.clear()
        blockColors.clear()
        textColors.clear()
        labelText.clear()
        val contentWidth = max(0f, width.toFloat() - timeWidth - horizontalPadding * 2)
        var index = 0
        while (index < layout.blocks.size) {
            val block = layout.blocks[index]
            val columnWidth = contentWidth / block.columnCount
            val left = timeWidth + horizontalPadding + block.column * columnWidth + blockGap
            val right = timeWidth + horizontalPadding + (block.column + 1) * columnWidth - blockGap
            val top = yForMinute(block.startMinute) + blockGap
            val bottom = max(top + dp(28f), yForMinute(block.endMinute) - blockGap)
            rects += RectF(left, top, right, bottom)
            blocks += block.session
            blockText += ""
            roomText += ""
            updateBlockText(index)
            val color = parseUserColor(block.session.subjectColor, primaryColor)
            blockColors += color
            textColors += contrastingTextColor(color)
            index++
        }
        examRects.clear()
        examTitles.clear()
        examDetails.clear()
        examColors.clear()
        // An exam that shares a slot with a class gets its own column on the right.
        val examStarts = IntArray(dayExams.size)
        val examEnds = IntArray(dayExams.size)
        val examColumns = IntArray(dayExams.size)
        val examColumnEnds = ArrayList<Int>(4)
        var examIndex = 0
        while (examIndex < dayExams.size) {
            val exam = dayExams[examIndex]
            val start = exam.startTime?.let(LocalTime::parse)
                ?.let { it.hour * 60 + it.minute } ?: 0
            examStarts[examIndex] = start
            examEnds[examIndex] = exam.endTime?.let(LocalTime::parse)
                ?.let { it.hour * 60 + it.minute }
                ?.takeIf { it > start } ?: (start + EXAM_HOUR_MINUTES)
            var column = 0
            while (column < examColumnEnds.size && examColumnEnds[column] > start) column++
            if (column == examColumnEnds.size) examColumnEnds += examEnds[examIndex]
            else examColumnEnds[column] = examEnds[examIndex]
            examColumns[examIndex] = column
            examIndex++
        }
        val examSlotCount = max(1, examColumnEnds.size)
        val contentLeft = timeWidth + horizontalPadding
        examIndex = 0
        while (examIndex < dayExams.size) {
            val exam = dayExams[examIndex]
            var collisionLeft = Float.MAX_VALUE
            var collisionRight = -1f
            var blockIndex = 0
            while (blockIndex < rects.size) {
                val block = layout.blocks[blockIndex]
                if (block.startMinute < examEnds[examIndex] && block.endMinute > examStarts[examIndex]) {
                    collisionLeft = min(collisionLeft, rects[blockIndex].left)
                    collisionRight = max(collisionRight, rects[blockIndex].right)
                }
                blockIndex++
            }
            val left: Float
            val right: Float
            if (collisionRight < 0f) {
                left = contentLeft + blockGap
                right = contentLeft + contentWidth - blockGap
            } else {
                val slot = (collisionRight - collisionLeft) / (examSlotCount + 1)
                right = collisionRight - slot * (examSlotCount - 1 - examColumns[examIndex])
                left = max(contentLeft + blockGap, right - max(slot, dp(64f)))
                blockIndex = 0
                while (blockIndex < rects.size) {
                    val block = layout.blocks[blockIndex]
                    if (block.startMinute < examEnds[examIndex] &&
                        block.endMinute > examStarts[examIndex] &&
                        rects[blockIndex].right > left
                    ) {
                        val rect = rects[blockIndex]
                        rect.right = max(rect.left + dp(16f), left - blockGap)
                        updateBlockText(blockIndex)
                    }
                    blockIndex++
                }
            }
            val top = yForMinute(examStarts[examIndex]) + blockGap
            val bottom = max(top + dp(28f), yForMinute(examEnds[examIndex]) - blockGap)
            examRects += RectF(left, top, right, bottom)
            examTitles += fitText(
                context.getString(R.string.exam_block_title, exam.subjectName ?: exam.title),
                right - left - dp(12f),
                boldTextPaint
            )
            val countdown = examCountdownLabel(examStarts[examIndex], examEnds[examIndex])
            val timeRange = exam.startTime?.let { startTime ->
                exam.endTime?.let { "$startTime-$it" } ?: startTime
            }
            examDetails += fitText(
                listOfNotNull(countdown, timeRange, exam.room).joinToString(" \u00b7 "),
                right - left - dp(12f),
                textPaint
            )
            examColors += parseUserColor(exam.subjectColor, primaryColor)
            examIndex++
        }
        val hours = layout.lastMinute / 60
        var hour = 0
        while (hour <= hours) {
            labelText += formatDisplayTime(LocalTime.of(hour % 24, 0), timeFormat)
            hour++
        }
    }
    private fun drawTimeLabel(canvas: Canvas, label: String, y: Float) {
        labelPaint.textAlign = Paint.Align.RIGHT
        canvas.drawText(label, timeWidth, y + dp(4f), labelPaint)
    }
    private fun updateBlockText(index: Int) {
        val rect = rects[index]
        val maxWidth = rect.right - rect.left - dp(12f)
        blockText[index] = fitText(blocks[index].subjectName, maxWidth, boldTextPaint)
        roomText[index] = fitText(blocks[index].room.orEmpty(), maxWidth, textPaint)
    }
    private fun fitText(value: String, maxWidth: Float, paint: Paint): String {
        if (maxWidth <= 0f || paint.measureText(value) <= maxWidth) return value
        var text = value
        while (text.length > 1 && paint.measureText(text) > maxWidth) {
            text = text.dropLast(2) + "\u2026"
        }
        return text
    }
    private fun dp(value: Float): Float = value * density
}
</file>

<file path="app/src/main/java/com/example/kronos/ui/timetable/TimetableViewModel.kt">
package com.example.kronos.ui.timetable
import android.content.Context
import androidx.lifecycle.ViewModel
import androidx.lifecycle.ViewModelProvider
import androidx.lifecycle.viewModelScope
import com.example.kronos.data.TimetableRepository
import com.example.kronos.data.local.ClassSession
import com.example.kronos.data.local.ClassSessionWithSubject
import com.example.kronos.data.local.Holiday
import com.example.kronos.lib.currentRotationWeek
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.StateFlow
import kotlinx.coroutines.flow.SharingStarted
import kotlinx.coroutines.flow.asStateFlow
import kotlinx.coroutines.flow.flatMapLatest
import kotlinx.coroutines.flow.stateIn
import kotlinx.coroutines.launch
import com.example.kronos.widget.TimetableWidgetProvider
class TimetableViewModel(
    private val repository: TimetableRepository,
    private val settings: com.example.kronos.data.SettingsStore,
    context: Context
) : ViewModel() {
    private val appContext = context.applicationContext
    private val selectedDay = MutableStateFlow(java.time.LocalDate.now().dayOfWeek.value)
    val day: StateFlow<Int> = selectedDay.asStateFlow()
    val sessions: StateFlow<List<ClassSessionWithSubject>> =
        selectedDay.flatMapLatest {
            repository.observeForDay(it, currentWeek())
        }
            .stateIn(
                viewModelScope,
                SharingStarted.WhileSubscribed(5_000),
                emptyList()
            )
    val weekSessions: StateFlow<List<ClassSessionWithSubject>> =
        repository.observeForWeek(currentWeek()).stateIn(
            viewModelScope,
            SharingStarted.WhileSubscribed(5_000),
            emptyList()
        )
    val holidays: StateFlow<List<Holiday>> = repository.observeHolidays().stateIn(
        viewModelScope, SharingStarted.WhileSubscribed(5_000), emptyList()
    )
    fun selectDay(dayOfWeek: Int) {
        selectedDay.value = dayOfWeek
    }
    fun currentWeek(): Int = currentRotationWeek(
        java.time.LocalDate.now(),
        settings.semesterStart,
        settings.rotationLength
    )
    fun save(
        existing: ClassSession?,
        subject: String,
        color: String,
        dayOfWeek: Int,
        start: java.time.LocalTime,
        end: java.time.LocalTime,
        room: String?,
        teacher: String?,
        notes: String?,
        weekNumber: Int,
        reminderEnabled: Boolean,
        reminderOffsetMinutes: Int?
    ) = viewModelScope.launch {
        repository.save(
            existing, subject, color, dayOfWeek, start, end, room, teacher, notes,
            weekNumber, reminderEnabled, reminderOffsetMinutes
        ).also { TimetableWidgetProvider.requestUpdate(appContext) }
    }
    fun delete(session: ClassSession) = viewModelScope.launch {
        repository.delete(session).also { TimetableWidgetProvider.requestUpdate(appContext) }
    }
    suspend fun findSession(id: Long): ClassSession? = repository.findSession(id)
    fun saveHoliday(holiday: Holiday) = viewModelScope.launch {
        repository.saveHoliday(holiday)
        TimetableWidgetProvider.requestUpdate(appContext)
    }
    fun deleteHoliday(holiday: Holiday) = viewModelScope.launch {
        repository.deleteHoliday(holiday)
        TimetableWidgetProvider.requestUpdate(appContext)
    }
    suspend fun findHoliday(id: Long): Holiday? = repository.findHoliday(id)
    class Factory(
        private val repository: TimetableRepository,
        private val settings: com.example.kronos.data.SettingsStore,
        private val context: Context
    ) : ViewModelProvider.Factory {
        @Suppress("UNCHECKED_CAST")
        override fun <T : ViewModel> create(modelClass: Class<T>): T =
            TimetableViewModel(repository, settings, context) as T
    }
}
</file>

<file path="app/src/main/java/com/example/kronos/ui/exams/ExamsFragment.kt">
package com.example.kronos.ui.exams
import android.os.Bundle
import android.view.LayoutInflater
import android.view.View
import android.view.ViewGroup
import android.widget.TextView
import androidx.core.view.isVisible
import androidx.fragment.app.Fragment
import androidx.fragment.app.viewModels
import androidx.lifecycle.Lifecycle
import androidx.lifecycle.lifecycleScope
import androidx.lifecycle.repeatOnLifecycle
import androidx.recyclerview.widget.GridLayoutManager
import androidx.recyclerview.widget.LinearLayoutManager
import com.example.kronos.R
import com.example.kronos.data.ExamRepository
import com.example.kronos.data.SettingsStore
import com.example.kronos.data.TimeFormat
import com.example.kronos.data.local.DatabaseProvider
import com.example.kronos.data.local.Exam
import com.example.kronos.data.local.ExamWithSubject
import com.example.kronos.data.local.Subject
import com.example.kronos.databinding.FragmentExamsBinding
import com.example.kronos.lib.CountdownKind
import com.example.kronos.lib.ExamSection
import com.example.kronos.lib.examCountdown
import com.example.kronos.lib.formatDayTitle
import com.example.kronos.lib.formatDisplayDate
import com.example.kronos.lib.formatDisplayTime
import com.example.kronos.lib.formatMonthTitle
import com.example.kronos.notifications.TaskExamReminderScheduler
import com.google.android.material.chip.Chip
import kotlinx.coroutines.launch
import java.time.LocalDate
import java.time.LocalTime
class ExamsFragment : Fragment() {
    private var _binding: FragmentExamsBinding? = null
    private val binding get() = _binding!!
    private val viewModel: ExamViewModel by viewModels {
        val db = DatabaseProvider.get(requireContext())
        ExamViewModel.Factory(
            ExamRepository(db.examDao(), db.subjectDao()),
            TaskExamReminderScheduler(requireContext()),
            SettingsStore(requireContext())
        )
    }
    private val monthAdapter = ExamMonthAdapter(::selectDate)
    private val dayAdapter = ExamAdapter(::editExam)
    private val listAdapter = ExamAdapter(::editExam, ::toggleSection)
    private val filterChips = LinkedHashMap<Long?, Chip>()
    private var pastExpanded = false
    private var timeFormat = TimeFormat.HOUR_24
    override fun onCreateView(inflater: LayoutInflater, container: ViewGroup?, state: Bundle?): View {
        _binding = FragmentExamsBinding.inflate(inflater, container, false)
        return binding.root
    }
    override fun onViewCreated(view: View, state: Bundle?) {
        binding.monthGrid.layoutManager = GridLayoutManager(requireContext(), CALENDAR_COLUMNS)
        binding.monthGrid.adapter = monthAdapter
        binding.dayList.layoutManager = LinearLayoutManager(requireContext())
        binding.dayList.adapter = dayAdapter
        binding.listMode.layoutManager = LinearLayoutManager(requireContext())
        binding.listMode.adapter = listAdapter
        binding.prevMonth.setOnClickListener { viewModel.onPrevMonth() }
        binding.nextMonth.setOnClickListener { viewModel.onNextMonth() }
        binding.addExam.setOnClickListener {
            viewLifecycleOwner.lifecycleScope.launch { openEditor(null) }
        }
        binding.modeToggle.addOnButtonCheckedListener { _, checkedId, isChecked ->
            if (!isChecked) return@addOnButtonCheckedListener
            viewModel.onSetMode(
                if (checkedId == R.id.modeCalendar) ExamViewMode.CALENDAR else ExamViewMode.LIST
            )
        }
        parentFragmentManager.setFragmentResultListener(
            ExamEditorBottomSheet.REQUEST, viewLifecycleOwner
        ) { _, result -> handleResult(result) }
        viewLifecycleOwner.lifecycleScope.launch {
            viewLifecycleOwner.repeatOnLifecycle(Lifecycle.State.STARTED) {
                launch { viewModel.subjects.collect { rebuildFilterChips(it) } }
                viewModel.uiState.collect(::render)
            }
        }
    }
    override fun onResume() {
        super.onResume()
        timeFormat = SettingsStore(requireContext()).timeFormat
        dayAdapter.timeFormat = timeFormat
        listAdapter.timeFormat = timeFormat
        viewModel.refreshToday()
    }
    private fun render(state: ExamUiState) {
        val calendarMode = state.mode == ExamViewMode.CALENDAR
        binding.modeToggle.check(if (calendarMode) R.id.modeCalendar else R.id.modeList)
        filterChips[state.filterSubjectId]?.isChecked = true
        binding.monthTitle.text = formatMonthTitle(state.month)
        state.weekdayLabels.forEachIndexed { index, label ->
            (binding.weekdayRow.getChildAt(index) as? TextView)?.text = label
        }
        monthAdapter.submitList(state.cells)
        binding.calendarGroup.isVisible = calendarMode && state.hasExams
        binding.listMode.isVisible = !calendarMode && state.hasExams
        binding.emptyExams.isVisible = !state.hasExams
        if (!state.hasExams) {
            binding.emptyExams.setText(
                if (state.filterSubjectId == null) {
                    R.string.no_exams_yet
                } else {
                    R.string.no_exams_match_filter
                }
            )
        }
        binding.dayTitle.text = formatDayTitle(state.selectedDate)
        dayAdapter.submitExams(state.selectedDateExams, state.today)
        binding.dayList.isVisible = state.selectedDateExams.isNotEmpty()
        binding.dayEmpty.isVisible = state.selectedDateExams.isEmpty()
        listAdapter.submitSections(state.sections, pastExpanded, state.today)
        val next = state.nextExam
        binding.nextExamTitle.isVisible = next != null
        if (next == null) {
            binding.nextExamSubtitle.text = getString(R.string.no_upcoming_exams)
        } else {
            binding.nextExamTitle.text = getString(
                R.string.next_exam_label, next.subjectName ?: next.title
            )
            binding.nextExamSubtitle.text = getString(
                R.string.next_exam_summary,
                countdownText(state.today, LocalDate.parse(next.date)),
                dateWithTime(next)
            )
        }
    }
    private fun rebuildFilterChips(subjects: List<Subject>) {
        binding.filterChips.removeAllViews()
        filterChips.clear()
        addFilterChip(null, getString(R.string.all))
        subjects.forEach { addFilterChip(it.id, it.name) }
        binding.filterChips.isVisible = subjects.isNotEmpty()
        filterChips[viewModel.uiState.value.filterSubjectId]?.isChecked = true
    }
    private fun addFilterChip(subjectId: Long?, label: String) {
        val density = resources.displayMetrics.density
        val chip = Chip(requireContext()).apply {
            id = View.generateViewId()
            text = label
            isCheckable = true
            textSize = 13f
            chipMinHeight = 32 * density
            chipStartPadding = 12 * density
            chipEndPadding = 12 * density
            setEnsureMinTouchTargetSize(false)
            setOnClickListener { viewModel.setFilter(subjectId) }
        }
        filterChips[subjectId] = chip
        binding.filterChips.addView(chip)
    }
    private fun countdownText(today: LocalDate, date: LocalDate): String {
        val countdown = examCountdown(today, date)
        return when (countdown.kind) {
            CountdownKind.TODAY -> getString(R.string.today)
            CountdownKind.TOMORROW -> getString(R.string.countdown_tomorrow)
            CountdownKind.DAYS -> getString(R.string.countdown_in_days, countdown.days)
            CountdownKind.PAST -> getString(R.string.countdown_past)
        }
    }
    private fun dateWithTime(exam: ExamWithSubject): String {
        val date = formatDisplayDate(LocalDate.parse(exam.date))
        val time = exam.startTime?.let { formatDisplayTime(LocalTime.parse(it), timeFormat) }
        return if (time == null) date else getString(R.string.date_with_time, date, time)
    }
    private fun selectDate(date: LocalDate) {
        viewModel.onSelectDate(date)
    }
    private fun toggleSection(section: ExamSection) {
        if (section != ExamSection.PAST) return
        pastExpanded = !pastExpanded
        val state = viewModel.uiState.value
        listAdapter.submitSections(state.sections, pastExpanded, state.today)
    }
    private suspend fun openEditor(exam: Exam?) {
        ExamEditorBottomSheet.new(exam, viewModel.getSubjects())
            .show(parentFragmentManager, "exam_editor")
    }
    private fun editExam(item: ExamWithSubject) {
        viewLifecycleOwner.lifecycleScope.launch { openEditor(viewModel.find(item.id)) }
    }
    private fun handleResult(result: Bundle) {
        val id = result.getLong(ExamEditorBottomSheet.RESULT_ID)
        if (result.getBoolean(ExamEditorBottomSheet.RESULT_DELETE)) {
            viewLifecycleOwner.lifecycleScope.launch { viewModel.find(id)?.let(viewModel::delete) }
            return
        }
        val start = result.getString(ExamEditorBottomSheet.RESULT_TIME)?.takeIf { it.isNotBlank() }
            ?.let(LocalTime::parse)
        val end = result.getString(ExamEditorBottomSheet.RESULT_END_TIME)?.takeIf { it.isNotBlank() }
            ?.let(LocalTime::parse)
        viewModel.save(
            Exam(
                id = id,
                title = viewModel.subjects.value.firstOrNull {
                    it.id == result.getLong(ExamEditorBottomSheet.RESULT_SUBJECT_ID)
                }?.name ?: "Exam",
                subjectId = result.getLong(ExamEditorBottomSheet.RESULT_SUBJECT_ID).takeUnless { it == 0L },
                date = LocalDate.parse(result.getString(ExamEditorBottomSheet.RESULT_DATE)),
                startTime = start,
                endTime = end?.takeIf { start != null && it > start },
                room = result.getString(ExamEditorBottomSheet.RESULT_ROOM)?.takeIf { it.isNotBlank() },
                seat = result.getString(ExamEditorBottomSheet.RESULT_SEAT)?.takeIf { it.isNotBlank() },
                notes = result.getString(ExamEditorBottomSheet.RESULT_NOTES)?.takeIf { it.isNotBlank() }
            )
        )
    }
    override fun onDestroyView() {
        binding.monthGrid.adapter = null
        binding.dayList.adapter = null
        binding.listMode.adapter = null
        _binding = null
        super.onDestroyView()
    }
    private companion object {
        const val CALENDAR_COLUMNS = 7
    }
}
</file>

<file path="app/src/main/java/com/example/kronos/ui/timetable/WeekGridView.kt">
package com.example.kronos.ui.timetable
import android.content.Context
import android.graphics.Canvas
import android.graphics.Paint
import android.graphics.RectF
import android.util.AttributeSet
import android.view.MotionEvent
import android.view.View
import androidx.core.graphics.ColorUtils
import com.example.kronos.data.local.ClassSessionWithSubject
import com.example.kronos.data.local.ExamWithSubject
import com.example.kronos.data.FirstDayOfWeek
import com.example.kronos.data.SettingsStore
import com.example.kronos.data.TimeFormat
import com.example.kronos.lib.dayColumnIndex
import com.example.kronos.lib.displayWeekdayLabels
import com.example.kronos.lib.formatDisplayTime
import com.example.kronos.lib.startOfDisplayedWeek
import com.example.kronos.R
import com.example.kronos.lib.contrastingTextColor
import com.example.kronos.lib.parseUserColor
import java.time.LocalTime
import java.time.LocalDate
import kotlin.math.max
class WeekGridView @JvmOverloads constructor(
    context: Context,
    attrs: AttributeSet? = null
) : View(context, attrs) {
    var onClassClick: ((ClassSessionWithSubject) -> Unit)? = null
    private var sessions: List<ClassSessionWithSubject> = emptyList()
    private var holidayDates: Set<LocalDate> = emptySet()
    private val blockRects = ArrayList<RectF>(24)
    private val blockSessions = ArrayList<ClassSessionWithSubject>(24)
    private var exams: List<ExamWithSubject> = emptyList()
    private val gridPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
        color = context.getColor(R.color.grid_line)
        strokeWidth = dp(1f)
    }
    private val textPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
        color = context.getColor(R.color.on_surface)
        textSize = dp(12f)
    }
    private val blockTextPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
        color = context.getColor(R.color.on_primary)
        textSize = dp(12f)
    }
    private val blockPaint = Paint(Paint.ANTI_ALIAS_FLAG)
    private val holidayPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
        color = context.getColor(R.color.holiday_overlay)
    }
    private val examRect = RectF()
    private val examFillPaint = Paint(Paint.ANTI_ALIAS_FLAG)
    private val examStrokePaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
        style = Paint.Style.STROKE
        strokeWidth = dp(1f)
    }
    private val examTextPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
        color = context.getColor(R.color.on_surface)
        textSize = dp(11f)
    }
    private val examTintAlpha = 0x1F
    private val days = arrayOf("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")
    private val rectPool = ArrayList<RectF>(24)
    private val hourHeight = dp(56f)
    private val headerHeight = dp(36f)
    private val minimumTimeWidth = dp(42f)
    private val padding = dp(8f)
    private val firstHour = 6
    private val lastHour = 22
    private var firstDay = SettingsStore(context).firstDayOfWeek
    private var timeFormat = SettingsStore(context).timeFormat
    private var weekdayLabels = displayWeekdayLabels(firstDay)
    private var timeLabels = emptyList<String>()
    init {
        rebuildLabels()
    }
    fun setDisplaySettings() {
        firstDay = SettingsStore(context).firstDayOfWeek
        timeFormat = SettingsStore(context).timeFormat
        rebuildLabels()
        invalidate()
    }
    private fun rebuildLabels() {
        weekdayLabels = displayWeekdayLabels(firstDay)
        timeLabels = (firstHour..lastHour).map {
            formatDisplayTime(LocalTime.of(it, 0), timeFormat)
        }
    }
    fun setSessions(value: List<ClassSessionWithSubject>) {
        sessions = value
        invalidate()
    }
    fun setHolidays(value: Set<LocalDate>) {
        holidayDates = value
        invalidate()
    }
    fun setExams(value: List<ExamWithSubject>) {
        exams = value
        invalidate()
    }
    override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
        val desiredHeight = (headerHeight + (lastHour - firstHour) * hourHeight + padding * 2).toInt()
        setMeasuredDimension(
            MeasureSpec.getSize(widthMeasureSpec),
            resolveSize(desiredHeight, heightMeasureSpec)
        )
    }
    override fun onDraw(canvas: Canvas) {
        super.onDraw(canvas)
        blockRects.clear()
        blockSessions.clear()
        textPaint.textSize = dp(12f)
        val timeWidth = max(
            minimumTimeWidth,
            (firstHour..lastHour)
                .maxOf { textPaint.measureText(formatDisplayTime(LocalTime.of(it, 0), timeFormat)) }
                .plus(dp(8f))
        )
        val columnWidth = (width - timeWidth - padding * 2) / days.size
        val left = padding + timeWidth
        val top = padding + headerHeight
        weekdayLabels.forEachIndexed { index, day ->
            val x = left + index * columnWidth
            textPaint.textAlign = Paint.Align.CENTER
            canvas.drawText(day, x + columnWidth / 2f, padding + headerHeight * .7f, textPaint)
            canvas.drawLine(x, top, x, top + (lastHour - firstHour) * hourHeight, gridPaint)
        }
        canvas.drawLine(left + days.size * columnWidth, top, left + days.size * columnWidth,
            top + (lastHour - firstHour) * hourHeight, gridPaint)
        textPaint.textAlign = Paint.Align.RIGHT
        for (hour in firstHour..lastHour) {
            val y = top + (hour - firstHour) * hourHeight
            canvas.drawText(
                timeLabels[hour - firstHour],
                timeWidth,
                y + dp(4f),
                textPaint
            )
            canvas.drawLine(left, y, left + days.size * columnWidth, y, gridPaint)
        }
        sessions.forEach { session ->
            val dayIndex = dayColumnIndex(session.dayOfWeek, firstDay)
            if (dayIndex !in 0..6) return@forEach
            val start = LocalTime.parse(session.startTime)
            val end = LocalTime.parse(session.endTime)
            val y = top + ((start.hour + start.minute / 60f) - firstHour) * hourHeight
            val bottom = top + ((end.hour + end.minute / 60f) - firstHour) * hourHeight
            if (bottom <= top || y >= height) return@forEach
            val rect = rectPool.getOrNull(blockRects.size) ?: RectF().also { rectPool += it }
            rect.set(
                left + dayIndex * columnWidth + dp(2f),
                max(top, y) + dp(2f),
                left + (dayIndex + 1) * columnWidth - dp(2f),
                minOf(bottom, height.toFloat() - dp(2f))
            )
            blockPaint.color = parseUserColor(session.subjectColor, context.getColor(R.color.primary))
            blockTextPaint.color = contrastingTextColor(blockPaint.color)
            canvas.drawRoundRect(rect, dp(4f), dp(4f), blockPaint)
            blockTextPaint.textAlign = Paint.Align.LEFT
            canvas.save()
            canvas.clipRect(rect)
            drawFittedText(
                canvas,
                session.subjectName,
                rect.left + dp(4f),
                rect.right - dp(4f),
                rect.top + dp(16f)
            )
            canvas.restore()
            blockRects += rect
            blockSessions += session
        }
        val weekStart = startOfDisplayedWeek(LocalDate.now(), firstDay)
        val weekEnd = weekStart.plusDays(6)
        exams.forEach { exam ->
            val date = LocalDate.parse(exam.date)
            if (date.isBefore(weekStart) || date.isAfter(weekEnd)) return@forEach
            val dayIndex = dayColumnIndex(date.dayOfWeek.value, firstDay)
            if (dayIndex !in 0..6) return@forEach
            val start = exam.startTime?.let(LocalTime::parse)
            val y = if (start == null) top + dp(2f)
            else top + ((start.hour + start.minute / 60f) - firstHour) * hourHeight
            if (y >= height) return@forEach
            val blockHeight = if (start == null) dp(28f) else hourHeight
            examRect.set(
                left + dayIndex * columnWidth + dp(2f),
                max(top, y) + dp(2f),
                left + (dayIndex + 1) * columnWidth - dp(2f),
                minOf(y + blockHeight, height.toFloat() - dp(2f))
            )
            val color = parseUserColor(exam.subjectColor, context.getColor(R.color.primary))
            examFillPaint.color = ColorUtils.setAlphaComponent(color, examTintAlpha)
            examStrokePaint.color = color
            canvas.drawRoundRect(examRect, dp(4f), dp(4f), examFillPaint)
            canvas.drawRoundRect(examRect, dp(4f), dp(4f), examStrokePaint)
            canvas.save()
            canvas.clipRect(examRect)
            drawFittedText(
                canvas,
                exam.subjectName ?: exam.title,
                examRect.left + dp(4f),
                examRect.right - dp(4f),
                examRect.top + dp(15f),
                examTextPaint
            )
            canvas.restore()
        }
        (0..6).forEach { dayIndex ->
            if (weekStart.plusDays(dayIndex.toLong()) in holidayDates) {
                val x = left + dayIndex * columnWidth
                canvas.drawRect(
                    x, padding, x + columnWidth,
                    top + (lastHour - firstHour) * hourHeight,
                    holidayPaint
                )
            }
        }
    }
    override fun onTouchEvent(event: MotionEvent): Boolean {
        if (event.action == MotionEvent.ACTION_UP) {
            var index = blockRects.lastIndex
            while (index >= 0) {
                if (blockRects[index].contains(event.x, event.y)) {
                    onClassClick?.invoke(blockSessions[index])
                    break
                }
                index--
            }
        }
        return true
    }
    private fun dp(value: Float): Float = value * resources.displayMetrics.density
    private fun drawFittedText(
        canvas: Canvas,
        value: String,
        left: Float,
        right: Float,
        baseline: Float,
        paint: Paint = blockTextPaint
    ) {
        val maxWidth = right - left
        if (maxWidth <= 0f) return
        var text = value
        while (text.length > 1 && paint.measureText(text) > maxWidth) {
            text = text.dropLast(2) + "\u2026"
        }
        canvas.drawText(text, left, baseline, paint)
    }
}
</file>

