        val tasks = mutableListOf(Task(7, 1))
        val categories = mutableListOf(1L)
        categories.remove(1L)
        tasks.replaceAll { it.copy(categoryId = null) }
        assertEquals(1, tasks.size)
        assertEquals(null, tasks.single().categoryId)
    }
