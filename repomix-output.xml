<file path="app/src/test/java/com/example/kronos/lib/DayTimelineLayoutTest.kt">
package com.example.kronos.lib
import com.example.kronos.data.local.ClassSessionWithSubject
import org.junit.Test
import kotlin.test.assertEquals
import kotlin.test.assertTrue
class DayTimelineLayoutTest {
    @Test
    fun axisAlwaysCoversTheFullDay() {
        val layout = calculateDayTimelineLayout(listOf(session(13, 14)))
        assertEquals(0, layout.firstMinute)
        assertEquals(24 * 60, layout.lastMinute)
        assertEquals(24 * 60, layout.durationMinutes)
    }
    @Test
    fun emptyDayStillCoversTheFullDay() {
        val layout = calculateDayTimelineLayout(emptyList())
        assertEquals(24 * 60, layout.durationMinutes)
        assertTrue(layout.blocks.isEmpty())
    }
    @Test
    fun singleClassGetsOneColumn() {
        val layout = calculateDayTimelineLayout(listOf(session(9, 10)))
        assertEquals(0, layout.blocks.single().column)
        assertEquals(1, layout.blocks.single().columnCount)
    }
    @Test
    fun backToBackClassesShareAColumn() {
        val layout = calculateDayTimelineLayout(listOf(session(9, 10), session(10, 11)))
        assertTrue(layout.blocks.all { it.columnCount == 1 })
    }
    @Test
    fun overlappingClassesSplitIntoColumns() {
        val layout = calculateDayTimelineLayout(listOf(session(9, 11), session(10, 12)))
        assertEquals(setOf(0, 1), layout.blocks.map { it.column }.toSet())
        assertTrue(layout.blocks.all { it.columnCount == 2 })
    }
    @Test
    fun threeOverlappingClassesUseThreeColumns() {
        val layout = calculateDayTimelineLayout(
            listOf(session(9, 12), session(10, 11), session(10, 12))
        )
        assertTrue(layout.blocks.all { it.columnCount == 3 })
    }
    @Test
    fun shortClassKeepsItsDuration() {
        val block = calculateDayTimelineLayout(listOf(session(9, 9, 15))).blocks.single()
        assertEquals(15, block.endMinute - block.startMinute)
    }
    @Test
    fun overnightClassKeepsItsDurationPastMidnight() {
        val block = calculateDayTimelineLayout(listOf(session(23, 1))).blocks.single()
        assertEquals(23 * 60, block.startMinute)
        assertEquals(25 * 60, block.endMinute)
    }
    @Test
    fun noClassesAndNotTodayScrollsToSevenAm() {
        assertEquals(420, initialScrollMinutes(emptyList(), isToday = false, nowMinutes = 0))
    }
    @Test
    fun singleClassAtThirteenScrollsOneHourEarlier() {
        assertEquals(
            12 * 60,
            initialScrollMinutes(listOf(13 * 60), isToday = false, nowMinutes = 0)
        )
    }
    @Test
    fun earlyClassClampsToMidnight() {
        assertEquals(0, initialScrollMinutes(listOf(30), isToday = false, nowMinutes = 0))
    }
    @Test
    fun lateClassKeepsScrollInsideTheDay() {
        assertEquals(
            22 * 60,
            initialScrollMinutes(listOf(23 * 60), isToday = false, nowMinutes = 0)
        )
    }
    @Test
    fun todayFollowsTheCurrentTime() {
        assertEquals(
            13 * 60 + 20,
            initialScrollMinutes(emptyList(), isToday = true, nowMinutes = 14 * 60 + 20)
        )
        assertEquals(0, initialScrollMinutes(listOf(8 * 60), isToday = true, nowMinutes = 20))
    }
    private fun session(startHour: Int, endHour: Int, endMinute: Int = 0) =
        ClassSessionWithSubject(
            id = startHour.toLong() * 100 + endHour,
            subjectId = 1,
            subjectName = "Subject",
            subjectColor = "#3F51B5",
            dayOfWeek = 1,
            startTime = "%02d:00".format(startHour),
            endTime = "%02d:%02d".format(endHour, endMinute),
            room = "Room",
            teacher = null,
            weekNumber = 0,
            notes = null,
            reminderEnabled = false,
            reminderOffsetMinutes = null
        )
}
</file>

<file path="app/src/test/java/com/example/kronos/lib/ExamCalendarTest.kt">
package com.example.kronos.lib
import com.example.kronos.data.FirstDayOfWeek
import com.example.kronos.data.local.ExamWithSubject
import org.junit.Test
import java.time.LocalDate
import java.time.YearMonth
import kotlin.test.assertEquals
import kotlin.test.assertFalse
import kotlin.test.assertNull
import kotlin.test.assertTrue
class ExamCalendarTest {
    private val today = LocalDate.of(2026, 11, 10)
    @Test
    fun countdownToday() {
        assertEquals(CountdownKind.TODAY, examCountdown(today, today).kind)
    }
    @Test
    fun countdownTomorrow() {
        assertEquals(CountdownKind.TOMORROW, examCountdown(today, today.plusDays(1)).kind)
    }
    @Test
    fun countdownInFiveDays() {
        val countdown = examCountdown(today, today.plusDays(5))
        assertEquals(CountdownKind.DAYS, countdown.kind)
        assertEquals(5L, countdown.days)
    }
    @Test
    fun countdownYesterday() {
        assertEquals(CountdownKind.PAST, examCountdown(today, today.minusDays(1)).kind)
    }
    @Test
    fun sectionsRespectTheSevenDayBoundary() {
        val groups = groupExams(
            listOf(
                exam("2026-11-10"),
                exam("2026-11-11"),
                exam("2026-11-17"),
                exam("2026-11-18"),
                exam("2026-11-09")
            ),
            today
        )
        assertEquals(
            listOf(ExamSection.TODAY, ExamSection.THIS_WEEK, ExamSection.LATER, ExamSection.PAST),
            groups.map { it.section }
        )
        assertEquals(listOf("2026-11-11", "2026-11-17"), groups[1].exams.map { it.date })
        assertEquals(listOf("2026-11-18"), groups[2].exams.map { it.date })
        assertEquals(listOf("2026-11-09"), groups[3].exams.map { it.date })
    }
    @Test
    fun emptySectionsAreOmitted() {
        assertEquals(
            listOf(ExamSection.LATER),
            groupExams(listOf(exam("2026-11-18")), today).map { it.section }
        )
        assertTrue(groupExams(emptyList(), today).isEmpty())
    }
    @Test
    fun pastSectionIsNewestFirst() {
        val groups = groupExams(
            listOf(exam("2026-11-01"), exam("2026-11-08"), exam("2026-11-05")),
            today
        )
        assertEquals(
            listOf("2026-11-08", "2026-11-05", "2026-11-01"),
            groups.single().exams.map { it.date }
        )
    }
    @Test
    fun sectionsSortByTimeWithinOneDay() {
        val groups = groupExams(
            listOf(exam("2026-11-12", "14:00"), exam("2026-11-12", "09:00")),
            today
        )
        assertEquals(listOf("09:00", "14:00"), groups.single().exams.map { it.startTime })
    }
    @Test
    fun nextExamStartsAtToday() {
        val exams = listOf(exam("2026-11-01"), exam("2026-11-20"), exam("2026-11-10", "09:00"))
        assertEquals("2026-11-10", nextExam(exams, today)?.date)
    }
    @Test
    fun nextExamIsNullWhenEverythingIsPast() {
        assertNull(nextExam(listOf(exam("2026-11-01"), exam("2026-11-09")), today))
        assertNull(nextExam(emptyList(), today))
    }
    @Test
    fun dotsAreCappedAtThreePerDay() {
        val exams = (1..5).map { exam("2026-11-12", id = it.toLong()) }
        val dots = examDotsByDate(exams)
        assertEquals(1, dots.size)
        assertEquals(MAX_DOTS_PER_DAY, dots.getValue(LocalDate.of(2026, 11, 12)).size)
    }
    @Test
    fun dotsUseTheExamDate() {
        val dots = examDotsByDate(
            listOf(exam("2026-11-12"), exam("2026-11-12"), exam("2026-11-13"))
        )
        assertEquals(2, dots.getValue(LocalDate.of(2026, 11, 12)).size)
        assertEquals(1, dots.getValue(LocalDate.of(2026, 11, 13)).size)
    }
    @Test
    fun shortAndLongMonthsAlwaysFillFortyTwoCells() {
        listOf(YearMonth.of(2026, 2), YearMonth.of(2026, 7)).forEach { month ->
            val cells = buildMonthCells(month, FirstDayOfWeek.MONDAY, today, today, emptyMap())
            assertEquals(MONTH_CELL_COUNT, cells.size)
            assertEquals(month.lengthOfMonth(), cells.count { it.inMonth })
        }
    }
    @Test
    fun mondayFirstStartsOnThePreviousMonday() {
        val cells = buildMonthCells(
            YearMonth.of(2026, 11), FirstDayOfWeek.MONDAY, today, today, emptyMap()
        )
        assertEquals(LocalDate.of(2026, 10, 26), cells.first().date)
        assertFalse(cells.first().inMonth)
        assertEquals(LocalDate.of(2026, 11, 1), cells[6].date)
        assertTrue(cells[6].inMonth)
    }
    @Test
    fun sundayFirstStartsOnTheFirstOfTheMonth() {
        val cells = buildMonthCells(
            YearMonth.of(2026, 11), FirstDayOfWeek.SUNDAY, today, today, emptyMap()
        )
        assertEquals(LocalDate.of(2026, 11, 1), cells.first().date)
        assertTrue(cells.first().inMonth)
    }
    @Test
    fun todaySelectedAndPastAreFlagged() {
        val selected = LocalDate.of(2026, 11, 12)
        val cells = buildMonthCells(
            YearMonth.of(2026, 11), FirstDayOfWeek.MONDAY, today, selected, emptyMap()
        )
        assertEquals(1, cells.count { it.isToday })
        assertEquals(today, cells.first { it.isToday }.date)
        assertEquals(1, cells.count { it.isSelected })
        assertEquals(selected, cells.first { it.isSelected }.date)
        assertTrue(cells.first { it.date == LocalDate.of(2026, 11, 9) }.isPast)
        assertFalse(cells.first { it.isToday }.isPast)
    }
    @Test
    fun dotsReachTheMatchingCellsOnly() {
        val dots = examDotsByDate(listOf(exam("2026-11-12"), exam("2026-11-12")))
        val cells = buildMonthCells(
            YearMonth.of(2026, 11), FirstDayOfWeek.MONDAY, today, today, dots
        )
        assertEquals(2, cells.first { it.date == LocalDate.of(2026, 11, 12) }.dotColors.size)
        assertEquals(1, cells.count { it.dotColors.isNotEmpty() })
    }
    private fun exam(date: String, time: String? = null, id: Long = 0) = ExamWithSubject(
        id = id,
        title = "Exam",
        subjectId = 1,
        subjectName = "Math",
        subjectColor = "#3F51B5",
        date = date,
        startTime = time,
        endTime = null,
        room = null,
        seat = null,
        notes = null
    )
}
</file>

<file path="app/src/test/java/com/example/kronos/lib/TaskStatusTest.kt">
package com.example.kronos.lib
import org.junit.Assert.assertEquals
import org.junit.Assert.assertFalse
import org.junit.Assert.assertNull
import org.junit.Assert.assertTrue
import org.junit.Test
import java.time.LocalDate
class TaskStatusTest {
    private val today = LocalDate.of(2026, 11, 7)
    private fun row(
        dueDate: LocalDate? = null,
        status: TaskStatus = TaskStatus.NOT_STARTED,
        priority: Int = 0,
        completedAt: Long? = null,
        title: String = ""
    ) = TaskListRow(dueDate, status, priority, completedAt, title)
    private fun sections(tasks: List<TaskListRow>, mode: TaskGroupMode) =
        groupTasks(tasks, today, mode) { it }
    @Test
    fun codesAreStableAndUnknownFallsBack() {
        assertEquals(
            listOf(0, 1, 2, 3, 4),
            TaskStatus.entries.map { it.code }
        )
        assertEquals(TaskStatus.NOT_STARTED, TaskStatus.fromCode(99))
        assertEquals(TaskStatus.DONE, TaskStatus.fromCode(4))
        assertEquals(AssignmentType.INDIVIDUAL, AssignmentType.fromCode(-1))
        assertEquals(AssignmentType.GROUP, AssignmentType.fromCode(1))
    }
    @Test
    fun enteringDoneStampsCompletedAt() {
        val next = applyStatusChange(TaskState(TaskStatus.IN_PROGRESS), TaskStatus.DONE, 1_000L)
        assertEquals(TaskStatus.DONE, next.status)
        assertEquals(1_000L, next.completedAt)
        assertTrue(next.done)
    }
    @Test
    fun editingAnAlreadyDoneTaskKeepsCompletedAt() {
        val next = applyStatusChange(TaskState(TaskStatus.DONE, 1_000L), TaskStatus.DONE, 2_000L)
        assertEquals(TaskStatus.DONE, next.status)
        assertEquals(1_000L, next.completedAt)
        assertTrue(next.done)
    }
    @Test
    fun leavingDoneClearsCompletedAt() {
        val next = applyStatusChange(TaskState(TaskStatus.DONE, 1_000L), TaskStatus.REVIEW, 2_000L)
        assertEquals(TaskStatus.REVIEW, next.status)
        assertNull(next.completedAt)
        assertFalse(next.done)
    }
    @Test
    fun doneFlagAlwaysFollowsStatus() {
        TaskStatus.entries.forEach { status ->
            assertEquals(status == TaskStatus.DONE, TaskState(status, 5L).done)
        }
    }
    @Test
    fun overdueExcludesDoneAndToday() {
        assertTrue(isOverdue(today.minusDays(1), TaskStatus.IN_PROGRESS, today))
        assertFalse(isOverdue(today, TaskStatus.IN_PROGRESS, today))
        assertFalse(isOverdue(today.minusDays(1), TaskStatus.DONE, today))
        assertFalse(isOverdue(null, TaskStatus.NOT_STARTED, today))
    }
    @Test
    fun filtersSelectTheRightTasks() {
        val rows = listOf(
            row(today.minusDays(2), TaskStatus.IN_PROGRESS),
            row(today, TaskStatus.NOT_STARTED),
            row(today.plusDays(1), TaskStatus.REVIEW),
            row(today.minusDays(3), TaskStatus.DONE)
        )
        fun filtered(filter: TaskFilter) = rows.filter { filter.matches(it, today) }
        assertEquals(rows, filtered(TaskFilter.ALL))
        assertEquals(rows.take(3), filtered(TaskFilter.ACTIVE))
        assertEquals(listOf(rows[0]), filtered(TaskFilter.OVERDUE))
        assertEquals(listOf(rows[3]), filtered(TaskFilter.DONE))
    }
    @Test
    fun dueDateBucketsRespectBoundaries() {
        val yesterday = row(today.minusDays(1), TaskStatus.IN_PROGRESS)
        val dueToday = row(today, TaskStatus.IN_PROGRESS)
        val inOneDay = row(today.plusDays(1), TaskStatus.IN_PROGRESS)
        val inSevenDays = row(today.plusDays(7), TaskStatus.IN_PROGRESS)
        val inEightDays = row(today.plusDays(8), TaskStatus.IN_PROGRESS)
        val noDate = row(null, TaskStatus.IN_PROGRESS)
        val doneYesterday = row(today.minusDays(1), TaskStatus.DONE, completedAt = 5L)
        val grouped = sections(
            listOf(yesterday, dueToday, inOneDay, inSevenDays, inEightDays, noDate, doneYesterday),
            TaskGroupMode.BY_DUE_DATE
        )
        assertEquals(
            listOf(
                TaskSectionKey.OVERDUE,
                TaskSectionKey.TODAY,
                TaskSectionKey.THIS_WEEK,
                TaskSectionKey.LATER,
                TaskSectionKey.NO_DATE,
                TaskSectionKey.DONE
            ),
            grouped.map { it.key }
        )
        assertEquals(listOf(yesterday), grouped[0].tasks)
        assertEquals(listOf(dueToday), grouped[1].tasks)
        assertEquals(listOf(inOneDay, inSevenDays), grouped[2].tasks)
        assertEquals(listOf(inEightDays), grouped[3].tasks)
        assertEquals(listOf(noDate), grouped[4].tasks)
        assertEquals(listOf(doneYesterday), grouped[5].tasks)
    }
    @Test
    fun emptySectionsAreOmitted() {
        val dueToday = row(today, TaskStatus.NOT_STARTED)
        val done = row(null, TaskStatus.DONE, completedAt = 1L)
        val grouped = sections(listOf(dueToday, done), TaskGroupMode.BY_DUE_DATE)
        assertEquals(listOf(TaskSectionKey.TODAY, TaskSectionKey.DONE), grouped.map { it.key })
        assertEquals(listOf(dueToday), grouped[0].tasks)
        assertEquals(listOf(done), grouped[1].tasks)
    }
    @Test
    fun sectionOrderIsDueDateThenPriorityThenTitle() {
        val highLater = row(today, TaskStatus.IN_PROGRESS, priority = 2, title = "b")
        val lowSoon = row(today, TaskStatus.IN_PROGRESS, priority = 0, title = "a")
        val highSoon = row(today, TaskStatus.IN_PROGRESS, priority = 2, title = "a")
        val tomorrow = row(today.plusDays(1), TaskStatus.IN_PROGRESS, priority = 0, title = "z")
        val grouped = sections(listOf(tomorrow, highLater, lowSoon, highSoon), TaskGroupMode.BY_DUE_DATE)
        assertEquals(
            listOf(TaskSectionKey.TODAY, TaskSectionKey.THIS_WEEK),
            grouped.map { it.key }
        )
        assertEquals(listOf(highSoon, highLater, lowSoon), grouped[0].tasks)
        assertEquals(listOf(tomorrow), grouped[1].tasks)
    }
    @Test
    fun doneSectionIsNewestFirst() {
        val older = row(today.minusDays(1), TaskStatus.DONE, completedAt = 100L)
        val newer = row(today.minusDays(3), TaskStatus.DONE, completedAt = 300L)
        val noStamp = row(today.minusDays(2), TaskStatus.DONE)
        val section = sections(listOf(older, noStamp, newer), TaskGroupMode.BY_DUE_DATE).single()
        assertEquals(TaskSectionKey.DONE, section.key)
        assertEquals(listOf(newer, older, noStamp), section.tasks)
    }
    @Test
    fun statusModeUsesFixedSectionOrder() {
        val done = row(today, TaskStatus.DONE, completedAt = 1L)
        val notStarted = row(today, TaskStatus.NOT_STARTED)
        val review = row(today, TaskStatus.REVIEW)
        val revision = row(today, TaskStatus.REVISION)
        val inProgress = row(today, TaskStatus.IN_PROGRESS)
        val grouped = sections(
            listOf(done, notStarted, review, revision, inProgress),
            TaskGroupMode.BY_STATUS
        )
        assertEquals(
            listOf(
                TaskSectionKey.IN_PROGRESS,
                TaskSectionKey.REVISION,
                TaskSectionKey.REVIEW,
                TaskSectionKey.NOT_STARTED,
                TaskSectionKey.DONE
            ),
            grouped.map { it.key }
        )
        assertEquals(listOf(inProgress), grouped[0].tasks)
        assertEquals(listOf(revision), grouped[1].tasks)
        assertEquals(listOf(review), grouped[2].tasks)
        assertEquals(listOf(notStarted), grouped[3].tasks)
        assertEquals(listOf(done), grouped[4].tasks)
    }
    @Test
    fun doneFilterGivesOneFlatSection() {
        val older = row(today, TaskStatus.DONE, completedAt = 1L)
        val newer = row(today.minusDays(3), TaskStatus.DONE, completedAt = 9L)
        val active = row(today, TaskStatus.IN_PROGRESS)
        val visible = listOf(older, newer, active).filter { TaskFilter.DONE.matches(it, today) }
        val grouped = sections(visible, TaskGroupMode.BY_DUE_DATE)
        assertEquals(1, grouped.size)
        assertEquals(TaskSectionKey.DONE, grouped[0].key)
        assertEquals(listOf(newer, older), grouped[0].tasks)
    }
    @Test
    fun summaryCountsTotalsOverdueAndPerStatus() {
        val rows = listOf(
            row(today.minusDays(1), TaskStatus.NOT_STARTED),
            row(today.minusDays(1), TaskStatus.IN_PROGRESS),
            row(today, TaskStatus.REVIEW),
            row(null, TaskStatus.REVISION),
            row(today.minusDays(4), TaskStatus.DONE),
            row(null, TaskStatus.DONE)
        )
        val summary = summarize(rows, today)
        assertEquals(6, summary.total)
        assertEquals(2, summary.overdue)
        assertEquals(1, summary.count(TaskStatus.NOT_STARTED))
        assertEquals(1, summary.count(TaskStatus.IN_PROGRESS))
        assertEquals(1, summary.count(TaskStatus.REVIEW))
        assertEquals(1, summary.count(TaskStatus.REVISION))
        assertEquals(2, summary.count(TaskStatus.DONE))
    }
}
</file>

