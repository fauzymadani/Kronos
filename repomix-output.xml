<file path="app/src/main/java/com/example/kronos/ui/tasks/TagView.kt">
package com.example.kronos.ui.tasks
import android.content.Context
import android.graphics.Canvas
import android.graphics.Paint
import android.graphics.RectF
import android.graphics.Typeface
import android.text.TextUtils
import android.util.AttributeSet
import android.util.TypedValue
import android.view.Gravity
import androidx.appcompat.widget.AppCompatTextView
import androidx.core.graphics.ColorUtils
class TagView @JvmOverloads constructor(
    context: Context,
    attrs: AttributeSet? = null
) : AppCompatTextView(context, attrs) {
    private val fillPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.FILL }
    private val strokePaint = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.STROKE }
    private val fillBounds = RectF()
    private val strokeBounds = RectF()
    private val radius = 6 * resources.displayMetrics.density
    private val strokeWidth = resources.displayMetrics.density
    init {
        setWillNotDraw(false)
        setTextSize(TypedValue.COMPLEX_UNIT_SP, 11f)
        typeface = Typeface.create("sans-serif-medium", Typeface.NORMAL)
        gravity = Gravity.CENTER
        includeFontPadding = false
        isSingleLine = true
        ellipsize = TextUtils.TruncateAt.END
        val horizontal = (8 * resources.displayMetrics.density).toInt()
        val vertical = (3 * resources.displayMetrics.density).toInt()
        setPadding(horizontal, vertical, horizontal, vertical)
    }
    fun setTagColors(fg: Int, bg: Int) {
        setTextColor(fg)
        fillPaint.color = bg
        strokePaint.strokeWidth = 0f
    }
    fun setTagOutline(color: Int) {
        setTextColor(color)
        fillPaint.color = ColorUtils.setAlphaComponent(color, TAG_TINT_ALPHA)
        strokePaint.color = color
        strokePaint.strokeWidth = strokeWidth
    }
    override fun onDraw(canvas: Canvas) {
        fillBounds.set(0f, 0f, width.toFloat(), height.toFloat())
        canvas.drawRoundRect(fillBounds, radius, radius, fillPaint)
        if (strokePaint.strokeWidth > 0f) {
            val inset = strokePaint.strokeWidth / 2f
            strokeBounds.set(inset, inset, width - inset, height - inset)
            canvas.drawRoundRect(strokeBounds, radius, radius, strokePaint)
        }
        super.onDraw(canvas)
    }
    private companion object {
        const val TAG_TINT_ALPHA = 0x1F
    }
}
</file>

<file path="app/src/main/java/com/example/kronos/ui/tasks/TaskLeadView.kt">
package com.example.kronos.ui.tasks
import android.content.Context
import android.graphics.Canvas
import android.graphics.Paint
import android.graphics.Rect
import android.graphics.RectF
import android.graphics.Typeface
import android.util.AttributeSet
import android.util.TypedValue
import android.view.View
import androidx.core.content.ContextCompat
import com.example.kronos.R
import com.google.android.material.color.MaterialColors
import kotlin.math.min
class TaskLeadView @JvmOverloads constructor(
    context: Context,
    attrs: AttributeSet? = null
) : View(context, attrs) {
    enum class State { NORMAL, TODAY, OVERDUE, NONE, DONE }
    private val density = resources.displayMetrics.density
    private val boxWidth = 52 * density
    private val boxHeight = 56 * density
    private val boxRadius = 10 * density
    private val checkSize = (20 * density).toInt()
    private val onSurface =
        MaterialColors.getColor(this, com.google.android.material.R.attr.colorOnSurface)
    private val onSurfaceVariant =
        MaterialColors.getColor(this, com.google.android.material.R.attr.colorOnSurfaceVariant)
    private val error = MaterialColors.getColor(this, com.google.android.material.R.attr.colorError)
    private val todayFill = ContextCompat.getColor(context, R.color.today_accent)
    private val todayText = ContextCompat.getColor(context, R.color.today_on_accent)
    private val overdueFill = ContextCompat.getColor(context, R.color.overdue_bg)
    private val noDate = context.getString(R.string.lead_no_date)
    private val fillPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.FILL }
    private val weekdayPaint = textPaint(10f)
    private val dayPaint = textPaint(20f).apply {
        typeface = Typeface.create("sans-serif-medium", Typeface.NORMAL)
    }
    private val monthPaint = textPaint(10f)
    private val symbolPaint = textPaint(18f)
    private val checkDrawable = ContextCompat.getDrawable(context, R.drawable.ic_check)
    private val box = RectF()
    private val checkBounds = Rect()
    private var state = State.NONE
    private var day = ""
    private var weekday = ""
    private var month = ""
    private var doneLabel = ""
    private fun textPaint(sizeSp: Float) = Paint(Paint.ANTI_ALIAS_FLAG).apply {
        textSize = TypedValue.applyDimension(
            TypedValue.COMPLEX_UNIT_SP, sizeSp, resources.displayMetrics
        )
        textAlign = Paint.Align.CENTER
        color = onSurfaceVariant
    }
    fun bind(
        state: State,
        day: String,
        weekday: String,
        month: String,
        doneLabel: String
    ) {
        if (state == this.state && day == this.day && weekday == this.weekday &&
            month == this.month && doneLabel == this.doneLabel
        ) {
            return
        }
        this.state = state
        this.day = day
        this.weekday = weekday
        this.month = month
        this.doneLabel = doneLabel
        invalidate()
    }
    override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
        val width = if (MeasureSpec.getMode(widthMeasureSpec) == MeasureSpec.EXACTLY) {
            MeasureSpec.getSize(widthMeasureSpec)
        } else {
            (68 * density).toInt()
        }
        val minHeight = (72 * density).toInt()
        val height = when (MeasureSpec.getMode(heightMeasureSpec)) {
            MeasureSpec.EXACTLY -> MeasureSpec.getSize(heightMeasureSpec)
            MeasureSpec.AT_MOST -> min(minHeight, MeasureSpec.getSize(heightMeasureSpec))
            else -> minHeight
        }
        setMeasuredDimension(width, height)
    }
    override fun onDraw(canvas: Canvas) {
        val top = (height - boxHeight) / 2f
        val left = paddingLeft.toFloat()
        val centerX = left + boxWidth / 2f
        if (state == State.TODAY || state == State.OVERDUE) {
            fillPaint.color = if (state == State.TODAY) todayFill else overdueFill
            box.set(left, top, left + boxWidth, top + boxHeight)
            canvas.drawRoundRect(box, boxRadius, boxRadius, fillPaint)
        }
        val strong = when (state) {
            State.TODAY -> todayText
            State.OVERDUE -> error
            else -> onSurface
        }
        val weak = when (state) {
            State.TODAY -> todayText
            State.OVERDUE -> error
            else -> onSurfaceVariant
        }
        when (state) {
            State.NONE -> {
                symbolPaint.color = weak
                canvas.drawText(
                    noDate, centerX, baseline(top + boxHeight / 2f, symbolPaint), symbolPaint
                )
            }
            State.DONE -> {
                val centerY = top + boxHeight / 4f
                val check = checkDrawable
                if (check != null) {
                    checkBounds.set(
                        (centerX - checkSize / 2f).toInt(),
                        (centerY - checkSize / 2f).toInt(),
                        (centerX + checkSize / 2f).toInt(),
                        (centerY + checkSize / 2f).toInt()
                    )
                    check.setBounds(checkBounds)
                    check.draw(canvas)
                }
                if (doneLabel.isNotEmpty()) {
                    weekdayPaint.color = weak
                    canvas.drawText(
                        doneLabel,
                        centerX,
                        baseline(top + boxHeight * 0.78f, weekdayPaint),
                        weekdayPaint
                    )
                }
            }
            else -> {
                weekdayPaint.color = weak
                dayPaint.color = strong
                monthPaint.color = weak
                canvas.drawText(
                    weekday, centerX, baseline(top + boxHeight * 0.26f, weekdayPaint), weekdayPaint
                )
                canvas.drawText(day, centerX, baseline(top + boxHeight * 0.5f, dayPaint), dayPaint)
                canvas.drawText(
                    month, centerX, baseline(top + boxHeight * 0.76f, monthPaint), monthPaint
                )
            }
        }
    }
    private fun baseline(centerY: Float, paint: Paint): Float =
        centerY - (paint.ascent() + paint.descent()) / 2f
}
</file>

<file path="app/src/main/java/com/example/kronos/widget/TimetableWidgetLogic.kt">
package com.example.kronos.widget
import com.example.kronos.data.local.ClassSessionWithSubject
import java.time.Clock
import java.time.LocalDate
import java.time.LocalDateTime
import java.time.LocalTime
data class WidgetRow(
    val session: ClassSessionWithSubject,
    val highlighted: Boolean,
    val ended: Boolean
)
data class WidgetContent(
    val rows: List<WidgetRow>,
    val moreCount: Int,
    val holidayName: String?,
    val empty: Boolean
)
fun buildWidgetContent(
    sessions: List<ClassSessionWithSubject>,
    holidayName: String?,
    clock: Clock,
    maxRows: Int = 5
): WidgetContent {
    if (holidayName != null) return WidgetContent(emptyList(), 0, holidayName, false)
    val now = LocalDateTime.now(clock)
    val sorted = sessions.sortedBy { LocalTime.parse(it.startTime) }
    val states = sorted.map { session ->
        val start = LocalDateTime.of(now.toLocalDate(), LocalTime.parse(session.startTime))
        var end = LocalDateTime.of(now.toLocalDate(), LocalTime.parse(session.endTime))
        if (!end.isAfter(start)) end = end.plusDays(1)
        WidgetRow(session, highlighted = !now.isBefore(start) && now.isBefore(end), ended = !end.isAfter(now))
    }
    val highlightedIndex = states.indexOfFirst { it.highlighted }.takeIf { it >= 0 }
        ?: states.indexOfFirst { !it.ended }.takeIf { it >= 0 }
    val rows = states.mapIndexed { index, row -> row.copy(highlighted = index == highlightedIndex) }
        .take(maxRows)
    return WidgetContent(rows, (states.size - rows.size).coerceAtLeast(0), null, states.isEmpty())
}
fun nextWidgetBoundary(
    sessions: List<ClassSessionWithSubject>,
    clock: Clock
): LocalDateTime {
    val now = LocalDateTime.now(clock)
    val midnight = now.toLocalDate().plusDays(1).atStartOfDay()
    val candidates = ArrayList<LocalDateTime>(sessions.size * 2 + 1)
    candidates += midnight
    sessions.forEach { session ->
        val start = LocalDateTime.of(now.toLocalDate(), LocalTime.parse(session.startTime))
        var end = LocalDateTime.of(now.toLocalDate(), LocalTime.parse(session.endTime))
        if (!end.isAfter(start)) end = end.plusDays(1)
        if (start.isAfter(now)) candidates += start
        if (end.isAfter(now)) candidates += end
    }
    return candidates.minOrNull() ?: midnight
}
</file>

