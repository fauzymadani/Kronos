import com.example.kronos.lib.AssignmentType
import com.example.kronos.lib.TaskStatus
import java.time.LocalDate
import java.time.LocalDateTime
import java.time.LocalTime
@Entity(
    tableName = "subjects",
    indices = [Index(value = ["name"], unique = true)]
)
data class Subject(
    @PrimaryKey(autoGenerate = true) val id: Long = 0,
    @ColumnInfo(collate = ColumnInfo.NOCASE) val name: String,
    val code: String? = null,
    val color: String? = null
)
@Entity(
    tableName = "class_sessions",
    foreignKeys = [
        ForeignKey(
            entity = Subject::class,
            parentColumns = ["id"],
            childColumns = ["subjectId"],
            onDelete = ForeignKey.CASCADE
        )
    ],
    indices = [Index("subjectId"), Index("dayOfWeek"), Index("weekNumber")]
)
data class ClassSession(
    @PrimaryKey(autoGenerate = true) val id: Long = 0,
    val subjectId: Long,
    val dayOfWeek: Int,
    val startTime: LocalTime,
    val endTime: LocalTime,
    val room: String? = null,
    val teacher: String? = null,
    val weekNumber: Int = 0,
    val notes: String? = null,
    val reminderEnabled: Boolean = false,
    val reminderOffsetMinutes: Int? = null
)
@Entity(
    tableName = "categories",
    indices = [Index(value = ["name"], unique = true)]
)
data class Category(
    @PrimaryKey(autoGenerate = true) val id: Long = 0,
    @ColumnInfo(collate = ColumnInfo.NOCASE) val name: String,
    val color: String? = null
)
@Entity(
    tableName = "tasks",
    foreignKeys = [
        ForeignKey(
            entity = Subject::class,
            parentColumns = ["id"],
            childColumns = ["subjectId"],
            onDelete = ForeignKey.SET_NULL
        ),
        ForeignKey(
            entity = Category::class,
            parentColumns = ["id"],
            childColumns = ["categoryId"],
            onDelete = ForeignKey.SET_NULL
        )
    ],
    indices = [Index("subjectId"), Index("categoryId"), Index("dueDate"), Index("done")]
)
data class Task(
    @PrimaryKey(autoGenerate = true) val id: Long = 0,
    val title: String,
    val notes: String? = null,
    val dueDate: LocalDate? = null,
    val dueTime: LocalTime? = null,
    val subjectId: Long? = null,
    val categoryId: Long? = null,
    val priority: Int = 0,
    val done: Boolean = false,
    val reminderTime: LocalDateTime? = null,
    @ColumnInfo(defaultValue = "0") val status: Int = TaskStatus.NOT_STARTED.code,
    @ColumnInfo(defaultValue = "0") val assignmentType: Int = AssignmentType.INDIVIDUAL.code,
    val completedAt: Long? = null
)
@Entity(
    tableName = "exams",
    foreignKeys = [
        ForeignKey(
            entity = Subject::class,
            parentColumns = ["id"],
            childColumns = ["subjectId"],
            onDelete = ForeignKey.SET_NULL
        )
    ],
    indices = [Index("subjectId"), Index("date")]
)
data class Exam(
    @PrimaryKey(autoGenerate = true) val id: Long = 0,
    val title: String,
    val subjectId: Long? = null,
    val date: LocalDate,
    val startTime: LocalTime? = null,
    val endTime: LocalTime? = null,
    val room: String? = null,
    val seat: String? = null,
    val notes: String? = null
)
@Entity(
    tableName = "holidays",
    indices = [Index("startDate"), Index("endDate")]
)
data class Holiday(
    @PrimaryKey(autoGenerate = true) val id: Long = 0,
    val name: String,
    val startDate: LocalDate,
    val endDate: LocalDate,
    val notes: String? = null
)
