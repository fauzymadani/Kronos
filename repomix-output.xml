<file path="app/src/test/java/com/example/kronos/notifications/ReminderScheduleCoordinatorTest.kt">
package com.example.kronos.notifications
import com.example.kronos.lib.HolidayRange
import com.example.kronos.lib.ReminderClass
import org.junit.Assert.assertEquals
import org.junit.Assert.assertTrue
import org.junit.Test
import java.time.Clock
import java.time.LocalDate
import java.time.LocalDateTime
import java.time.LocalTime
import java.time.ZoneId
class ReminderScheduleCoordinatorTest {
    private val zone = ZoneId.of("Asia/Bangkok")
    private val now = LocalDateTime.of(2026, 11, 2, 8, 55)
    private val clock = Clock.fixed(now.atZone(zone).toInstant(), zone)
    private val gateway = FakeAlarmGateway()
    private val coordinator = ReminderScheduleCoordinator(
        gateway = gateway,
        clock = clock,
        semesterStart = LocalDate.of(2026, 11, 2),
        rotationLength = 1,
        defaultOffsetMinutes = 10
    )
    @Test
    fun pastReminderIsSkippedToNextValidOccurrence() {
        coordinator.saveClass(classInfo(), emptyList())
        assertEquals(
            millis(LocalDateTime.of(2026, 11, 9, 8, 50)),
            gateway.single().triggerAtMillis
        )
    }
    @Test
    fun savingEnabledClassSchedulesExactlyOneAlarm() {
        coordinator.saveClass(classInfo(), emptyList())
        assertEquals(1, gateway.active.size)
        assertEquals(ClassReminderScheduler.requestCode(42), gateway.single().requestCode)
    }
    @Test
    fun turningReminderOffCancelsAlarm() {
        coordinator.saveClass(classInfo(), emptyList())
        coordinator.saveClass(classInfo(reminderEnabled = false), emptyList())
        assertTrue(gateway.active.isEmpty())
        assertEquals(
            listOf(ClassReminderScheduler.requestCode(42), ClassReminderScheduler.requestCode(42)),
            gateway.cancelled
        )
    }
    @Test
    fun deletingClassCancelsAlarm() {
        coordinator.saveClass(classInfo(), emptyList())
        coordinator.deleteClass(42)
        assertTrue(gateway.active.isEmpty())
        assertEquals(
            listOf(ClassReminderScheduler.requestCode(42), ClassReminderScheduler.requestCode(42)),
            gateway.cancelled
        )
    }
    @Test
    fun editingClassTimeReplacesOldAlarmWithOneUsingSameRequestCode() {
        coordinator.saveClass(classInfo(), emptyList())
        coordinator.saveClass(
            classInfo(startTime = LocalTime.of(10, 0)),
            emptyList()
        )
        assertEquals(1, gateway.active.size)
        assertEquals(ClassReminderScheduler.requestCode(42), gateway.single().requestCode)
        assertEquals(millis(LocalDateTime.of(2026, 11, 2, 9, 50)), gateway.single().triggerAtMillis)
        assertEquals(2, gateway.cancelled.size)
    }
    @Test
    fun rescheduleAllRecreatesAllEnabledAlarms() {
        val second = classInfo(id = 43, startTime = LocalTime.of(10, 0))
        coordinator.rescheduleAll(
            sessions = listOf(classInfo(), second, classInfo(id = 44, reminderEnabled = false)),
            holidays = emptyList()
        )
        assertEquals(setOf(42L, 43L).map(ClassReminderScheduler::requestCode).toSet(),
            gateway.active.keys)
        assertEquals(3, gateway.cancelled.size)
    }
    @Test
    fun holidayOnNextOccurrenceIsSkipped() {
        coordinator.saveClass(
            classInfo(),
            listOf(HolidayRange(LocalDate.of(2026, 11, 9), LocalDate.of(2026, 11, 9)))
        )
        assertEquals(
            millis(LocalDateTime.of(2026, 11, 16, 8, 50)),
            gateway.single().triggerAtMillis
        )
    }
    @Test
    fun afterAlarmFiresNextAlarmIsStrictlyAfterFiredOccurrence() {
        coordinator.scheduleNextAfter(
            session = classInfo(),
            firedOccurrence = LocalDateTime.of(2026, 11, 2, 9, 0),
            holidays = emptyList()
        )
        assertEquals(
            millis(LocalDateTime.of(2026, 11, 9, 9, 0)),
            gateway.single().occurrenceAtMillis
        )
    }
    private fun classInfo(
        id: Long = 42,
        startTime: LocalTime = LocalTime.of(9, 0),
        reminderEnabled: Boolean = true
    ) = ReminderScheduleClass(
        id = id,
        subject = "Mathematics",
        reminderEnabled = reminderEnabled,
        reminderOffsetMinutes = null,
        reminderClass = ReminderClass(1, startTime, 0)
    )
    private fun millis(value: LocalDateTime): Long =
        value.atZone(zone).toInstant().toEpochMilli()
    private class FakeAlarmGateway : AlarmGateway {
        val active = linkedMapOf<Int, AlarmCall>()
        val cancelled = mutableListOf<Int>()
        override fun schedule(
            requestCode: Int,
            triggerAtMillis: Long,
            itemId: Long,
            occurrenceAtMillis: Long,
            title: String,
            channelId: String
        ) {
            active[requestCode] = AlarmCall(
                requestCode,
                triggerAtMillis,
                itemId,
                occurrenceAtMillis,
                title
            )
        }
        override fun cancel(requestCode: Int) {
            cancelled += requestCode
            active.remove(requestCode)
        }
        fun single(): AlarmCall = active.values.single()
    }
    private data class AlarmCall(
        val requestCode: Int,
        val triggerAtMillis: Long,
        val sessionId: Long,
        val occurrenceAtMillis: Long,
        val subject: String
    )
}
</file>

<file path="app/src/test/java/com/example/kronos/notifications/TaskExamScheduleCoordinatorTest.kt">
package com.example.kronos.notifications
import com.example.kronos.data.local.Exam
import com.example.kronos.data.local.Task
import org.junit.Assert.assertEquals
import org.junit.Assert.assertTrue
import org.junit.Test
import java.time.Clock
import java.time.LocalDate
import java.time.LocalDateTime
import java.time.LocalTime
import java.time.ZoneId
class TaskExamScheduleCoordinatorTest {
    private val zone = ZoneId.of("Asia/Bangkok")
    private val clock = Clock.fixed(
        LocalDateTime.of(2026, 11, 1, 12, 0).atZone(zone).toInstant(), zone
    )
    private val gateway = FakeAlarmGateway()
    private val coordinator = TaskExamScheduleCoordinator(
        gateway, clock, ReminderSettings(examReminderHour = LocalTime.of(9, 0))
    )
    @Test
    fun taskInPastIsNotScheduled() {
        coordinator.saveTask(Task(id = 1, title = "Past", reminderTime = LocalDateTime.of(2026, 11, 1, 11, 0)))
        assertTrue(gateway.active.isEmpty())
    }
    @Test
    fun completingTaskCancelsAndUndoReschedules() {
        val task = Task(id = 1, title = "Task", reminderTime = LocalDateTime.of(2026, 11, 2, 9, 0))
        coordinator.saveTask(task)
        coordinator.saveTask(task.copy(done = true))
        assertTrue(gateway.active.isEmpty())
        coordinator.saveTask(task.copy(done = false))
        assertEquals(1, gateway.active.size)
    }
    @Test
    fun editingTaskTimeReplacesAlarm() {
        coordinator.saveTask(Task(id = 1, title = "Task", reminderTime = LocalDateTime.of(2026, 11, 2, 9, 0)))
        coordinator.saveTask(Task(id = 1, title = "Task", reminderTime = LocalDateTime.of(2026, 11, 2, 10, 0)))
        assertEquals(1, gateway.active.size)
        assertEquals(millis(LocalDateTime.of(2026, 11, 2, 10, 0)), gateway.active.values.single().triggerAtMillis)
    }
    @Test
    fun deletingTaskOrExamCancels() {
        coordinator.saveTask(Task(id = 1, title = "Task", reminderTime = LocalDateTime.of(2026, 11, 2, 9, 0)))
        coordinator.deleteTask(1)
        coordinator.saveExam(Exam(id = 2, title = "Exam", date = LocalDate.of(2026, 11, 3), startTime = LocalTime.of(10, 0)))
        coordinator.cancelExam(2)
        assertTrue(gateway.active.isEmpty())
    }
    @Test
    fun examSchedulesConfiguredLeadsAndSkipsPastOnes() {
        coordinator.saveExam(Exam(id = 2, title = "Exam", date = LocalDate.of(2026, 11, 2), startTime = LocalTime.of(12, 30)))
        assertEquals(1, gateway.active.size)
        assertEquals(
            millis(LocalDateTime.of(2026, 11, 2, 11, 30)),
            gateway.active.values.single().triggerAtMillis
        )
    }
    @Test
    fun requestCodesAreNamespaced() {
        val codes = setOf(
            ClassReminderScheduler.requestCode(5, ReminderItemType.CLASS),
            ClassReminderScheduler.requestCode(5, ReminderItemType.TASK),
            ClassReminderScheduler.requestCode(5, ReminderItemType.EXAM)
        )
        assertEquals(3, codes.size)
    }
    @Test
    fun rescheduleAllPlanRecreatesClassTaskAndExamAlarms() {
        val classCoordinator = ReminderScheduleCoordinator(
            gateway, clock, LocalDate.of(2026, 11, 1), 1, 10
        )
        classCoordinator.rescheduleAll(
            listOf(
                ReminderScheduleClass(
                    5, "Class", true, null,
                    com.example.kronos.lib.ReminderClass(2, LocalTime.of(9, 0), 0)
                )
            ),
            emptyList()
        )
        coordinator.rescheduleTasks(
            listOf(Task(id = 6, title = "Task", reminderTime = LocalDateTime.of(2026, 11, 2, 9, 0)))
        )
        coordinator.rescheduleExams(
            listOf(Exam(id = 7, title = "Exam", date = LocalDate.of(2026, 11, 3)))
        )
        assertEquals(4, gateway.active.size)
    }
    private fun millis(value: LocalDateTime) =
        value.atZone(zone).toInstant().toEpochMilli()
    private class FakeAlarmGateway : AlarmGateway {
        val active = linkedMapOf<Int, AlarmCall>()
        override fun schedule(
            requestCode: Int, triggerAtMillis: Long, itemId: Long,
            occurrenceAtMillis: Long, title: String, channelId: String
        ) {
            active[requestCode] = AlarmCall(triggerAtMillis)
        }
        override fun cancel(requestCode: Int) {
            active.remove(requestCode)
        }
    }
    private data class AlarmCall(val triggerAtMillis: Long)
}
</file>

<file path="app/src/test/java/com/example/kronos/widget/TimetableWidgetLogicTest.kt">
package com.example.kronos.widget
import com.example.kronos.data.local.ClassSessionWithSubject
import java.time.Clock
import java.time.Instant
import java.time.LocalDateTime
import java.time.ZoneId
import kotlin.test.assertEquals
import kotlin.test.assertTrue
import org.junit.Test
class TimetableWidgetLogicTest {
    private val zone = ZoneId.of("Asia/Bangkok")
    private val date = LocalDateTime.of(2026, 11, 1, 10, 0)
    private val clock = Clock.fixed(date.atZone(zone).toInstant(), zone)
    @Test fun noClassesIsEmpty() {
        assertTrue(buildWidgetContent(emptyList(), null, clock).empty)
    }
    @Test fun allEndedAreDimmedAndNextIsNotHighlighted() {
        val content = buildWidgetContent(listOf(session("08:00", "09:00")), null, clock)
        assertTrue(content.rows.single().ended)
        assertTrue(!content.rows.single().highlighted)
    }
    @Test fun runningClassIsHighlighted() {
        val row = buildWidgetContent(listOf(session("09:00", "11:00")), null, clock).rows.single()
        assertTrue(row.highlighted)
        assertTrue(!row.ended)
    }
    @Test fun laterClassIsHighlightedAsNext() {
        val rows = buildWidgetContent(
            listOf(session("08:00", "09:00"), session("12:00", "13:00")), null, clock
        ).rows
        assertTrue(!rows[0].highlighted)
        assertTrue(rows[1].highlighted)
    }
    @Test fun limitsRowsAndReportsMore() {
        val content = buildWidgetContent((8..14).map { session("%02d:00".format(it), "%02d:30".format(it)) }, null, clock)
        assertEquals(5, content.rows.size)
        assertEquals(2, content.moreCount)
    }
    @Test fun holidayReplacesClasses() {
        val content = buildWidgetContent(listOf(session("09:00", "10:00")), "Holiday", clock)
        assertEquals("Holiday", content.holidayName)
        assertTrue(content.rows.isEmpty())
    }
    @Test fun classEndingExactlyNowIsEnded() {
        val row = buildWidgetContent(listOf(session("09:00", "10:00")), null, clock).rows.single()
        assertTrue(row.ended)
        assertTrue(!row.highlighted)
    }
    @Test fun nextBoundaryAfterLastClassIsMidnight() {
        assertEquals(
            date.toLocalDate().plusDays(1).atStartOfDay(),
            nextWidgetBoundary(listOf(session("08:00", "09:00")), clock)
        )
    }
    private fun session(start: String, end: String) = ClassSessionWithSubject(
        id = start.hashCode().toLong(),
        subjectId = 1,
        subjectName = "Subject",
        subjectColor = "#3F51B5",
        dayOfWeek = 7,
        startTime = start,
        endTime = end,
        room = "Room",
        teacher = null,
        weekNumber = 0,
        notes = null,
        reminderEnabled = false,
        reminderOffsetMinutes = null
    )
}
