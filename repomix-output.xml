    fun whitespaceIsTrimmed() {
        val store = store()
        store.upsert(Entry(1, "  Physics  "))
        assertEquals("Physics", store.values().single().name)
    }
    @Test
    fun deletingCategoryInUseDoesNotDeleteTask() {
